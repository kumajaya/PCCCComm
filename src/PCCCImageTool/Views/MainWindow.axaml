<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCCCImageTool.ViewModels"
        xmlns:conv="clr-namespace:PCCCImageTool.Converters"
        x:Class="PCCCImageTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PCCC Image Transfer Tool"
        Width="600" Height="800"
        CanResize="True" MinWidth="600" MinHeight="800">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <conv:TransportTypeToStringConverter x:Key="TransportTypeToStringConverter" />
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Status bar pinned to bottom -->
        <Border DockPanel.Dock="Bottom"
                Background="#E0E0E0"
                Padding="6,4"
                CornerRadius="3"
                Margin="0,6,0,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" />
        </Border>

        <!-- Main content: fixed-height sections + stretching Log -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ── Communication Settings ───────────────────────────────── -->
            <Border Grid.Row="0"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
                    Padding="10" Margin="0,0,0,6">
                <StackPanel>

                    <!-- Header row: title + About button -->
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="Communication Settings"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="About"
                                Command="{Binding AboutCommand}"
                                HorizontalAlignment="Right"
                                Padding="8,2" FontSize="11" />
                    </DockPanel>

                    <!-- Transport selector + transport-specific settings.
                         All three Grids share the same ColumnDefinitions so
                         labels and fields stay aligned regardless of which
                         transport panel is visible. -->
                    <Grid ColumnDefinitions="3*,3*,3*,3*" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0" Text="Transport:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Column="1"
                                   IsEnabled="{Binding !IsConnected}"
                                   ItemsSource="{Binding TransportOptions}"
                                   SelectedItem="{Binding TransportType}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TransportTypeToStringConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Connect / Disconnect buttons -->
                        <StackPanel Grid.Column="2" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Right" Margin="0,3,0,3">
                            <Button Content="Refresh"
                                    IsEnabled="{Binding !IsConnected}"
                                    Command="{Binding RefreshPortsCommand}" />
                            <Button Content="Connect"
                                    Command="{Binding ConnectCommand}"
                                    IsVisible="{Binding !IsConnected}" />
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectCommand}"
                                    IsVisible="{Binding IsConnected}" />
                        </StackPanel>
                    </Grid>

                    <!-- DF1 serial settings (collapsed when TransportType != Df1FullDuplex) -->
                    <Grid ColumnDefinitions="3*,3*,3*,3*"
                          RowDefinitions="Auto,Auto,Auto"
                          IsEnabled="{Binding !IsConnected}"
                          IsVisible="{Binding TransportType,
                              Converter={StaticResource EnumToBooleanConverter},
                              ConverterParameter=Df1FullDuplex}">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="COM Port:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="0" Grid.Column="1"
                                   ItemsSource="{Binding AvailablePorts}"
                                   SelectedItem="{Binding SelectedPort}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Baud Rate:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="0" Grid.Column="3"
                                   ItemsSource="{Binding BaudRates}"
                                   SelectedItem="{Binding SelectedBaud}"
                                   HorizontalAlignment="Stretch" Margin="0,3,0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Parity:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="1" Grid.Column="1"
                                   ItemsSource="{Binding ParityOptions}"
                                   SelectedItem="{Binding SelectedParity}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Checksum:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="1" Grid.Column="3"
                                   ItemsSource="{Binding ChecksumOptions}"
                                   SelectedItem="{Binding SelectedChecksum}"
                                   HorizontalAlignment="Stretch" Margin="0,3,0,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="My Node:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding MyNode}"
                                       Minimum="0" Maximum="31" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Target Node:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="2" Grid.Column="3"
                                       Value="{Binding TargetNode}"
                                       Minimum="0" Maximum="31" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,0,3" />
                    </Grid>

                    <!-- DF1 half‑duplex master settings (collapsed when TransportType != Df1HalfDuplex) -->
                    <Grid ColumnDefinitions="3*,3*,3*,3*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          IsEnabled="{Binding !IsConnected}"
                          IsVisible="{Binding TransportType,
                              Converter={StaticResource EnumToBooleanConverter},
                              ConverterParameter=Df1HalfDuplex}">

                        <!-- Row 0: COM Port & Baud Rate -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="COM Port:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="0" Grid.Column="1"
                                   ItemsSource="{Binding AvailablePorts}"
                                   SelectedItem="{Binding SelectedPort}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Baud Rate:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="0" Grid.Column="3"
                                   ItemsSource="{Binding BaudRates}"
                                   SelectedItem="{Binding SelectedBaud}"
                                   HorizontalAlignment="Stretch" Margin="0,3,0,3" />

                        <!-- Row 1: Parity & Checksum -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Parity:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="1" Grid.Column="1"
                                   ItemsSource="{Binding ParityOptions}"
                                   SelectedItem="{Binding SelectedParity}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Checksum:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="1" Grid.Column="3"
                                   ItemsSource="{Binding ChecksumOptions}"
                                   SelectedItem="{Binding SelectedChecksum}"
                                   HorizontalAlignment="Stretch" Margin="0,3,0,3" />

                        <!-- Row 2: My Node & Target Node (Slave) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="My Node:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding MyNode}"
                                       Minimum="0" Maximum="31" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Target Node:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="2" Grid.Column="3"
                                       Value="{Binding TargetNode}"
                                       Minimum="1" Maximum="254" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,0,3" />

                        <!-- Row 3: RS-485 Mode & Echo Suppression -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="RS-485 Mode:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <ComboBox  Grid.Row="3" Grid.Column="1"
                                   ItemsSource="{Binding Rs485Modes}"
                                   SelectedItem="{Binding Rs485Mode}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <CheckBox  Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2"
                                   Content="Echo Suppression"
                                   IsChecked="{Binding EchoSuppression}"
                                   VerticalAlignment="Center" Margin="0,3,0,3" />

                        <!-- Row 4: RTS Assert Delay & RTS Deassert Delay -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="RTS Assert:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="4" Grid.Column="1"
                                       Value="{Binding RtsAssertDelay}"
                                       Minimum="0" Maximum="100" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="RTS Deassert:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="4" Grid.Column="3"
                                       Value="{Binding RtsDeassertDelay}"
                                       Minimum="0" Maximum="100" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,0,3" />
                    </Grid>

                    <!-- EIP settings (collapsed when TransportType != Eip) -->
                    <Grid ColumnDefinitions="3*,3*,3*,3*"
                          RowDefinitions="Auto,Auto,Auto"
                          IsEnabled="{Binding !IsConnected}"
                          IsVisible="{Binding TransportType,
                              Converter={StaticResource EnumToBooleanConverter},
                              ConverterParameter=Eip}">

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   Text="{Binding EipHost}"
                                   HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Port:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="0" Grid.Column="3"
                                       Value="{Binding EipPort}"
                                       Minimum="1" Maximum="65535" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,0,3" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Timeout (ms):"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding EipTimeout}"
                                       Minimum="1000" Maximum="30000" Increment="500"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,10,3" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="My Node:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding MyNode}"
                                       Minimum="0" Maximum="31" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,10,3" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Target Node:"
                                   VerticalAlignment="Center" Margin="0,3,8,3" />
                        <NumericUpDown Grid.Row="2" Grid.Column="3"
                                       Value="{Binding TargetNode}"
                                       Minimum="0" Maximum="31" Increment="1"
                                       FormatString="0"
                                       HorizontalAlignment="Stretch" Margin="0,3,0,3" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Program Transfer ─────────────────────────────────────── -->
            <Border Grid.Row="1"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
                    Padding="10" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="Program Transfer" FontWeight="Bold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                        <Button Content="Upload  (PLC → File)"
                                Command="{Binding UploadCommand}"
                                IsEnabled="{Binding CanUpload}"
                                Width="170"
                                Background="#2E7D32" Foreground="White"
                                BorderThickness="0" />
                        <Button Content="Compare"
                                Command="{Binding CompareCommand}"
                                IsEnabled="{Binding CanCompare}"
                                Width="170"
                                Background="#1565C0" Foreground="White"
                                BorderThickness="0" />
                        <Button Content="Download  (File → PLC)"
                                Command="{Binding DownloadCommand}"
                                IsEnabled="{Binding CanDownload}"
                                Width="170"
                                Background="#C62828" Foreground="White"
                                BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Progress ─────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
                    Padding="10" Margin="0,0,0,6">
                <StackPanel Spacing="5">
                    <TextBlock Text="Progress" FontWeight="Bold" />
                    <ProgressBar Value="{Binding ProgressValue}"
                                 Minimum="0" Maximum="100" Height="16" />
                    <TextBlock Text="{Binding ProgressMessage}"
                               FontSize="11" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ── Log (stretches to fill remaining height) ─────────────── -->
            <Border Grid.Row="3"
                    BorderBrush="Gray" BorderThickness="1" CornerRadius="5"
                    Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                        <TextBlock Text="Log" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <Button Content="Clear"
                                Command="{Binding ClearLogCommand}"
                                HorizontalAlignment="Right"
                                Padding="8,2" FontSize="11" />
                    </DockPanel>
                    <!-- Last child of DockPanel gets all remaining space -->
                    <TextBox x:Name="LogTextBox"
                             Text="{Binding LogText}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas,Courier New,monospace"
                             FontSize="11"
                             BorderThickness="0"
                             VerticalAlignment="Stretch" />
                </DockPanel>
            </Border>

        </Grid>
    </DockPanel>
</Window>
